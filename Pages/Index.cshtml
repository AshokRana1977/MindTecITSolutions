                        </div>
                    </div>

                    <a class="contact-item text-decoration-none" href="tel:+14377826494" style="color: inherit;" aria-label="Call Mindtec at (437) 782-6494">
                        <div class="contact-icon"><i class="bi bi-telephone"></i></div>
                        <div>
                            <h6 class="mb-1">Call Us</h6>
                            <span class="text-muted">(437) 782-6494</span>
                        </div>
                    </a>
                    <div class="contact-item mb-0">
                        <div class="contact-icon"><i class="bi bi-envelope"></i></div>
                        <div>
                            <h6 class="mb-1">Email Us</h6>
                            <span class="text-muted">
                                <a href="mailto:Info@mindtec.ca" class="text-decoration-none" style="color: inherit;">Info@mindtec.ca</a><br>
                                <a href="mailto:Dheeraj@mindtec.ca" class="text-decoration-none" style="color: inherit;">Dheeraj@mindtec.ca</a>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7" data-aos="fade-left">
                <div class="contact-info" style="border-top: 5px solid var(--accent-color);">
                    <h3 class="mb-4">Schedule a Free Consultation</h3>
                    <form id="consultationForm" method="POST">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="userName" class="form-label text-muted small fw-semibold">User Name</label>
                                <input type="text" name="UserName" class="form-control px-3" id="userName" placeholder="John Doe" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="mobileNumber" class="form-label text-muted small fw-semibold">Mobile Number</label>
                                <input type="tel" name="MobileNumber" class="form-control px-3" id="mobileNumber" placeholder="+1 (555) 000-0000" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="emailAddress" class="form-label text-muted small fw-semibold">Email Address</label>
                            <input type="email" name="Email" class="form-control px-3" id="emailAddress" placeholder="john@example.com" required>
                        </div>
                        <div class="mb-4">
                            <label for="message" class="form-label text-muted small fw-semibold">Message</label>
                            <textarea name="Message" class="form-control px-3 py-3" id="message" rows="4" placeholder="How can we help your business?" required></textarea>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-orange py-3 fs-6" id="submitBtn">Submit Request</button>
                        </div>
                        <div id="formMessage" class="mt-3 text-center alert @(!string.IsNullOrEmpty(Model.LblMessage) && Model.LblMessage.Contains("Sent") ? "alert-success" : "alert-danger") @(string.IsNullOrEmpty(Model.LblMessage) ? "d-none" : "") py-2 border-0 small fw-semibold" style="border-radius: 12px;">
                            @Model.LblMessage
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('consultationForm');
            const submitBtn = document.getElementById('submitBtn');
            const formMessage = document.getElementById('formMessage');
            if (!form) return;

            function show(cls, html) {
                formMessage.className = 'mt-3 text-center alert ' + cls + ' py-2 border-0 small fw-semibold';
                formMessage.style.borderRadius = '12px';
                formMessage.innerHTML = html;
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Sending Mail...';
                show('alert-info', '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Sending Mail...');

                fetch(window.location.href, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(r => {
                    if (!r.ok) throw new Error('Server returned HTTP ' + r.status);
                    return r.json();
                })
                .then(data => {
                    if (data && data.success) {
                        show('alert-success', data.message || 'Mail Sent');
                        form.reset();
                    } else {
                        show('alert-danger', (data && data.message) ? data.message : 'Error sending mail');
                    }
                })
                .catch(err => show('alert-danger', 'Error sending mail: ' + err.message))
                .finally(() => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = 'Submit Request';
                });
            });
        });
    </script>
}
