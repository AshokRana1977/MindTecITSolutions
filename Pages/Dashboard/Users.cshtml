@page
@model MindtecFinance.Pages.Dashboard.UsersModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_DashboardLayout";
}

<div class="container" style="padding-top: 30px; padding-bottom: 80px;">

    <!-- Page Header -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h6 class="text-uppercase fw-bold text-muted mb-1"><i class="bi bi-dash-lg me-2 text-warning"></i>Administration</h6>
            <h2 class="fw-bold mb-0">User Management</h2>
        </div>
        <div class="col-auto">
            <button class="btn btn-orange px-4 py-2" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="bi bi-person-plus me-2"></i>New User
            </button>
        </div>
    </div>

    <!-- Success / Error Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small border-0" style="border-radius: 10px;" role="alert">
            <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small border-0" style="border-radius: 10px;" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Users Table -->
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small fw-bold">
                            <th class="ps-4" style="width: 50px;">#</th>
                            <th>USERNAME</th>
                            <th>EMAIL</th>
                            <th>USER TYPE</th>
                            <th>STATUS</th>
                            <th class="pe-4 text-end">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-people d-block fs-1 mb-2 opacity-25"></i>
                                    No users found. Click "New User" to add one.
                                </td>
                            </tr>
                        }
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@user.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 32px; height: 32px; background: rgba(234,88,12,0.1); color: var(--accent-color); font-weight: 600; font-size: 0.8rem;">
                                            @user.UserName[0].ToString().ToUpper()
                                        </div>
                                        <span class="fw-semibold">@user.UserName</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@user.Email</td>
                                <td>
                                    @{
                                        string badgeClass = user.UserType switch
                                        {
                                            "Admin" => "bg-danger bg-opacity-10 text-danger",
                                            "Operator" => "bg-primary bg-opacity-10 text-primary",
                                            _ => "bg-secondary bg-opacity-10 text-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass fw-normal px-3 py-1" style="border-radius: 6px;">@user.UserType</span>
                                </td>
                                <td>
                                    @if (user.Status.ToLower() == "active")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-normal px-3 py-1" style="border-radius: 6px;">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary fw-normal px-3 py-1" style="border-radius: 6px;">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <button class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px; font-size: 0.8rem;"
                                            data-bs-toggle="modal" data-bs-target="#editUserModal"
                                            onclick="populateEditModal(@user.Id, '@user.UserName.Replace("'", "\\'")','@user.Email.Replace("'", "\\'")',@user.UserTypeId,'@user.Status')">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="text-muted small mt-3 ps-1">
        <i class="bi bi-info-circle me-1"></i> Total Users: <strong>@Model.Users.Count</strong>
    </div>
</div>

<!-- ═══════ CREATE USER MODAL ═══════ -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold" id="createUserModalLabel">
                        <i class="bi bi-person-plus me-2 text-warning"></i>Create New User
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 pt-3 pb-2">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">User Name <span class="text-danger">*</span></label>
                        <input asp-for="NewUser.UserName" class="form-control" style="border-radius: 10px; padding: 10px 14px;" placeholder="Enter username" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Email <span class="text-danger">*</span></label>
                        <input asp-for="NewUser.Email" type="email" class="form-control" style="border-radius: 10px; padding: 10px 14px;" placeholder="user@example.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Password <span class="text-danger">*</span></label>
                        <input asp-for="NewUser.Password" type="password" class="form-control" style="border-radius: 10px; padding: 10px 14px;" placeholder="Enter password" required minlength="5" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold text-muted">User Type</label>
                            <select asp-for="NewUser.UserTypeId" class="form-select" style="border-radius: 10px; padding: 10px 14px;" required>
                                <option value="">-- Select Type --</option>
                                @foreach (var opt in Model.UserTypeOptions)
                                {
                                    <option value="@opt.Id">@opt.Name</option>
                                }
                            </select>
                            <!-- Validation message -->
                            <span asp-validation-for="NewUser.UserTypeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold text-muted">Status</label>
                            <select asp-for="NewUser.Status" class="form-select" style="border-radius: 10px; padding: 10px 14px;">
                                <option value="active" selected>Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light px-4" style="border-radius: 10px;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-orange px-4" style="border-radius: 10px;">
                        <i class="bi bi-check-lg me-1"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══════ EDIT USER MODAL ═══════ -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold" id="editUserModalLabel">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Edit User
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 pt-3 pb-2">
                    <input type="hidden" asp-for="EditUser.Id" id="editUserId" />
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">User Name <span class="text-danger">*</span></label>
                        <input asp-for="EditUser.UserName" class="form-control" id="editUserName" style="border-radius: 10px; padding: 10px 14px;" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Email <span class="text-danger">*</span></label>
                        <input asp-for="EditUser.Email" type="email" class="form-control" id="editEmail" style="border-radius: 10px; padding: 10px 14px;" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Password <span class="text-muted">(leave blank to keep current)</span></label>
                        <input asp-for="EditUser.Password" type="password" class="form-control" id="editPassword" style="border-radius: 10px; padding: 10px 14px;" placeholder="••••••••"  />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold text-muted">User Type</label>
                            <select asp-for="EditUser.UserTypeId" class="form-select" id="editUserType" style="border-radius: 10px; padding: 10px 14px;" >
                                @foreach (var opt in Model.UserTypeOptions)
                                {
                                    <option value="@opt.Id">@opt.Name</option>
                                }
                            </select>

                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold text-muted">Status</label>
                            <select asp-for="EditUser.Status" class="form-select" id="editStatus" style="border-radius: 10px; padding: 10px 14px;">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light px-4" style="border-radius: 10px;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-orange px-4" style="border-radius: 10px;">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function populateEditModal(id, userName, email, userTypeId, status) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editUserName').value = userName;
        document.getElementById('editEmail').value = email;
        document.getElementById('editPassword').value = '';
        document.getElementById('editUserType').value = userTypeId;
        document.getElementById('editStatus').value = status;
    }
</script>
}
