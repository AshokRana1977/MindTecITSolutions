@page
@model MindtecFinance.Pages.Dashboard.UserTypeManagementModel
@{
    ViewData["Title"] = "User Type Management";
    Layout = "_DashboardLayout";
}

<div class="container" style="padding-top: 30px; padding-bottom: 80px;">

    <!-- Page Header -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h6 class="text-uppercase fw-bold text-muted mb-1"><i class="bi bi-dash-lg me-2 text-warning"></i>Masters</h6>
            <h2 class="fw-bold mb-0">User Type Management</h2>
        </div>
        <div class="col-auto">
            <button class="btn btn-orange px-4 py-2" data-bs-toggle="modal" data-bs-target="#createUserTypeModal">
                <i class="bi bi-plus-circle me-2"></i>New User Type
            </button>
        </div>
    </div>

    <!-- Success / Error Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small border-0" style="border-radius: 10px;" role="alert">
            <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small border-0" style="border-radius: 10px;" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- User Types Table -->
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small fw-bold">
                            <th class="ps-4" style="width: 50px;">#</th>
                            <th>TYPE NAME</th>
                            <th>DESCRIPTION</th>
                            <th class="pe-4 text-end">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.UserTypes.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <i class="bi bi-shield-lock d-block fs-1 mb-2 opacity-25"></i>
                                    No user types found. Click "New User Type" to add one.
                                </td>
                            </tr>
                        }
                        @foreach (var type in Model.UserTypes)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@type.Id</td>
                                <td>
                                    <span class="fw-semibold">@type.TypeName</span>
                                </td>
                                <td class="text-muted small">@type.Description</td>
                                <td class="pe-4 text-end">
                                    @if (type.TypeName != "SA")
                                    {
                                        <button class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px; font-size: 0.8rem;"
                                                data-bs-toggle="modal" data-bs-target="#editUserTypeModal"
                                                onclick="populateEditTypeModal(@type.Id, '@type.TypeName.Replace("'", "\\'")', '@type.Description?.Replace("'", "\\'")')">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="text-muted small mt-3 ps-1">
        <i class="bi bi-info-circle me-1"></i> Total Types: <strong>@Model.UserTypes.Count</strong>
    </div>
</div>

<!-- ═══════ CREATE USER TYPE MODAL ═══════ -->
<div class="modal fade" id="createUserTypeModal" tabindex="-1" aria-labelledby="createUserTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold" id="createUserTypeModalLabel">
                        <i class="bi bi-plus-circle me-2 text-warning"></i>Create New User Type
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 pt-3 pb-2">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Type Name <span class="text-danger">*</span></label>
                        <input asp-for="NewUserType.TypeName" class="form-control" style="border-radius: 10px; padding: 10px 14px;" placeholder="e.g. Admin" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Description</label>
                        <textarea asp-for="NewUserType.Description" class="form-control" style="border-radius: 10px; padding: 10px 14px;" placeholder="Enter description" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light px-4" style="border-radius: 10px;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-orange px-4" style="border-radius: 10px;">
                        <i class="bi bi-check-lg me-1"></i>Create Type
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══════ EDIT USER TYPE MODAL ═══════ -->
<div class="modal fade" id="editUserTypeModal" tabindex="-1" aria-labelledby="editUserTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold" id="editUserTypeModalLabel">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Edit User Type
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 pt-3 pb-2">
                    <input type="hidden" asp-for="EditUserType.Id" id="editTypeId" />
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Type Name <span class="text-danger">*</span></label>
                        <input asp-for="EditUserType.TypeName" class="form-control" id="editTypeName" style="border-radius: 10px; padding: 10px 14px;" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Description</label>
                        <textarea asp-for="EditUserType.Description" class="form-control" id="editDescription" style="border-radius: 10px; padding: 10px 14px;" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light px-4" style="border-radius: 10px;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-orange px-4" style="border-radius: 10px;">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function populateEditTypeModal(id, typeName, description) {
        document.getElementById('editTypeId').value = id;
        document.getElementById('editTypeName').value = typeName;
        document.getElementById('editDescription').value = description || '';
    }
</script>
}
