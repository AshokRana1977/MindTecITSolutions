@page
@model MindtecFinance.Pages.Dashboard.ClientsModel
@{
    ViewData["Title"] = "Client Management";
    Layout = "_DashboardLayout";
}

<div class="container" style="padding-top: 30px; padding-bottom: 80px;">

    <!-- Page Header -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h6 class="text-uppercase fw-bold text-muted mb-1"><i class="bi bi-dash-lg me-2 text-warning"></i>Operations</h6>
            <h2 class="fw-bold mb-0">Client Management</h2>
        </div>
        <div class="col-auto">
            <button class="btn btn-orange px-4 py-2" data-bs-toggle="modal" data-bs-target="#clientModal" onclick="prepareAdd()">
                <i class="bi bi-plus-square me-2"></i>New Client
            </button>
        </div>
    </div>

    <!-- Success / Error Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small border-0" style="border-radius: 10px;" role="alert">
            <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small border-0" style="border-radius: 10px;" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Clients Table -->
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small fw-bold">
                            <th class="ps-4" style="width: 50px;">ID</th>
                            <th>COMPANY NAME</th>
                            <th>PRIMARY CONTACT</th>
                            <th>EMAIL</th>
                            <th>PHONE</th>
                            <th>ADDRESS</th>
                            <th class="pe-4 text-end">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Companies.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-briefcase d-block fs-1 mb-2 opacity-25"></i>
                                    No clients found. Click "New Client" to add one.
                                </td>
                            </tr>
                        }
                        @foreach (var company in Model.Companies)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@company.CompanyId</td>
                                <td class="fw-semibold">@company.CompanyName</td>
                                <td>
                                    <span class="text-muted small">@company.PrimaryContactName</span>
                                </td>
                                <td class="text-muted small">@company.CompanyEmail</td>
                                <td class="text-muted small">@company.CompanyPhone</td>
                                <td class="text-muted small"> @company.CompanyAddress </td>
                                <td class="pe-4 text-end">
                                    <button class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px; font-size: 0.8rem;"
                                            data-bs-toggle="modal" data-bs-target="#clientModal"
                                            onclick="loadAndEdit(@company.CompanyId)">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ═══════ UNIFIED CLIENT MODAL (ADD & EDIT) ═══════ -->
<div class="modal fade" id="clientModal" tabindex="-1" aria-labelledby="clientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <form method="post" asp-page-handler="Save">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold" id="clientModalLabel">
                        <i class="bi bi-briefcase me-2 text-warning"></i><span id="formTitle">Add Client</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 pt-3 pb-2">
                    <input type="hidden" asp-for="InputCompany.CompanyId" id="companyIdHidden" />

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Company Name <span class="text-danger">*</span></label>
                            <input asp-for="InputCompany.CompanyName" id="companyName" class="form-control" style="border-radius: 10px; padding: 10px 14px;" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted">Phone</label>
                            <input asp-for="InputCompany.CompanyPhone" id="companyPhone" class="form-control" style="border-radius: 10px; padding: 10px 14px;" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted">Email</label>
                            <input asp-for="InputCompany.CompanyEmail" id="companyEmail" type="email" class="form-control" style="border-radius: 10px; padding: 10px 14px;" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Website</label>
                            <input asp-for="InputCompany.CompanyWebsite" id="companyWebsite" class="form-control" style="border-radius: 10px; padding: 10px 14px;" placeholder="https://" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Address</label>
                            <textarea asp-for="InputCompany.CompanyAddress" id="companyAddress" class="form-control" style="border-radius: 10px; padding: 10px 14px;" rows="2"></textarea>
                        </div>
                    </div>

                    <!-- Contact Details Section -->
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold mb-0">Contact Details</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addContactRow()">
                            <i class="bi bi-plus me-1"></i>Add Contact
                        </button>
                    </div>

                    <div id="contactsContainer" class="mb-3">
                        <!-- Dynamic Contact Rows Go Here -->
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light px-4" style="border-radius: 10px;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-orange px-4" style="border-radius: 10px;">
                        <i class="bi bi-check-lg me-1"></i>Save Client
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let contactIndex = 0;

        function prepareAdd() {
            document.getElementById('formTitle').innerText = "Add Client";
            document.getElementById('companyIdHidden').value = '0';
            document.getElementById('companyName').value = '';
            document.getElementById('companyPhone').value = '';
            document.getElementById('companyEmail').value = '';
            document.getElementById('companyWebsite').value = '';
            document.getElementById('companyAddress').value = '';
            document.getElementById('contactsContainer').innerHTML = '';
            contactIndex = 0;
            addContactRow(true); // Add one default primary contact row
        }

        async function loadAndEdit(id) {
            document.getElementById('formTitle').innerText = "Edit Client";
            document.getElementById('contactsContainer').innerHTML = '';
            contactIndex = 0;

            try {
                const response = await fetch(`/Dashboard/Clients?handler=Details&id=${id}`);
                if (response.ok) {
                    const data = await response.json();
                    document.getElementById('companyIdHidden').value = data.companyId;
                    document.getElementById('companyName').value = data.companyName;
                    document.getElementById('companyPhone').value = data.companyPhone || '';
                    document.getElementById('companyEmail').value = data.companyEmail || '';
                    document.getElementById('companyWebsite').value = data.companyWebsite || '';
                    document.getElementById('companyAddress').value = data.companyAddress || '';

                    if (data.contacts && data.contacts.length > 0) {
                        data.contacts.forEach(contact => {
                            addContactRow(false, contact);
                        });
                    } else {
                        addContactRow(true);
                    }
                }
            } catch (error) {
                console.error("Error loading client:", error);
                alert("Failed to load client details.");
            }
        }

        function addContactRow(isPrimary = false, existingData = null) {
            const container = document.getElementById('contactsContainer');
            const index = contactIndex++;

            const row = document.createElement('div');
            row.className = "row bg-light p-3 mb-2 small-contact-row";
            row.style.borderRadius = "12px";
            row.style.border = "1px solid #e9ecef";

            row.innerHTML = `
                <div class="col-md-3">
                    <label class="form-label text-muted extra-small">Name *</label>
                    <input type="text" name="InputCompany.Contacts[${index}].Name" class="form-control form-control-sm" value="${existingData?.name || ''}" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted extra-small">Title</label>
                    <input type="text" name="InputCompany.Contacts[${index}].Title" class="form-control form-control-sm" value="${existingData?.title || ''}" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted extra-small">Email</label>
                    <input type="email" name="InputCompany.Contacts[${index}].Email" class="form-control form-control-sm" value="${existingData?.email || ''}" />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted extra-small">Phone</label>
                    <input type="text" name="InputCompany.Contacts[${index}].Phone" class="form-control form-control-sm" value="${existingData?.phone || ''}" />
                </div>
                <div class="col-md-2 d-flex flex-column align-items-center justify-content-end pb-1">
                    <div class="form-check mb-1">
                        <input class="form-check-input primary-radio" type="radio" name="PrimarySelection"
                               ${(existingData ? existingData.primaryContact : isPrimary) ? 'checked' : ''}
                               onclick="updatePrimaryFlags(${index})">
                        <label class="form-check-label extra-small">Primary</label>
                    </div>
                    <input type="hidden" id="primaryFlag_${index}" name="InputCompany.Contacts[${index}].PrimaryContact"
                           value="${(existingData ? existingData.primaryContact : isPrimary) ? 'true' : 'false'}" />
                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="this.closest('.small-contact-row').remove()">
                        Remove
                    </button>
                </div>
            `;
            container.appendChild(row);
        }

        function updatePrimaryFlags(selectedIndex) {
            const flags = document.querySelectorAll('input[id^="primaryFlag_"]');
            flags.forEach((f, i) => {
                const rowIdx = f.id.replace('primaryFlag_', '');
                f.value = (rowIdx == selectedIndex) ? 'true' : 'false';
            });
        }
    </script>

    <style>
        .extra-small {
            font-size: 0.72rem;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .form-control-sm {
            border-radius: 8px;
            font-size: 0.85rem;
        }

        .small-contact-row {
            transition: 0.2s ease;
        }

            .small-contact-row:hover {
                background-color: #f1f3f5 !important;
            }
    </style>
}
